{
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "bcryptjs": "^3.0.0",
    "hono": "^4.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "description": "Ringkas — Rangkuman Materi SD, SMP, SMA. Standalone SvelteKit + Hono + SQLite.",
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "name": "ringkas-app",
  "private": true,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json --noEmit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "concurrently \"vite dev --port 5173\" \"tsx watch server/index.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite dev --port 5173",
    "make-admin": "tsx server/scripts/make-admin.ts",
    "seed": "tsx server/scripts/seed.ts",
    "start": "tsx server/index.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply ringkas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ringkas-db --remote",
    "db:seed": "wrangler d1 execute ringkas-db --local --file=server/seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute ringkas-db --remote --file=server/seed/seed.sql",
    "seed:dump": "tsx server/scripts/dump-seed-sql.ts",
    "sas:import": "tsx server/scripts/import-sas-docx.ts"
  },
  "type": "module",
  "version": "1.0.0"
}
